<%- include('header') %>
<main class="page-content">
    <section class="content-inner-2 bg-light z-2" style="background-image: url(images/background/bg5.png);">
        <div class="container">
            <div class="row align-items-end content-wrapper style-8" style="justify-content: center;">
                <style>
                    .wizard-container {
                        background-color: transparent;
                        max-width: 800px;
                        margin: 12px auto;
                    }
                    .progress-bar {
                        display: none;
                        justify-content: space-between;
                        margin-bottom: 20px;
                    }
                    .step {
                        text-align: center;
                        padding: 5px;
                        background-color: lightgray;
                        border-radius: 4px;
                    }
                    .step-content {
                        display: none;
                    }
                    .step-content h2 {
                        margin-bottom: 30px;
                    }
                    .step-content.active {
                        display: block;
                    }
                    .date-tabs {
                        display: flex;
                        flex-wrap: nowrap;
                        gap: 10px;
                        padding: 0 20px 10px 10px;
                        overflow-x: auto;
                        white-space: nowrap;
                        scrollbar-width: thin;
                        scrollbar-color: #ecf5fb transparent;
                    }
                    .date-tabs::-webkit-scrollbar {
                        width: 0;
                        height: 0;
                    }
                    .date-tabs::-webkit-scrollbar-thumb {
                        background-color: transparent;
                    }
                    .date-tabs::-webkit-scrollbar-track {
                        background-color: transparent;
                    }
                    .date-tab {
                        display: inline-block;
                        min-width: 140px;
                        padding: 15px 0;
                        border: 1px solid #ccc;
                        border-radius: 10px;
                        cursor: pointer;
                        text-align: center;
                        transition: background-color 0.3s ease, transform 0.2s;
                        background-color: #fff;
                    }
                    .date-tab.selected {
                        border: 2px solid #2ab0e5;
                    }
                    .date-tab.selected strong,
                    .date-tab.selected span {
                        color: #031B4e !important;
                    }
                    .date-tab img {
                        width: 20px;
                        padding-bottom: 5px;
                    }
                    .date-tab span {
                        display: block;
                        font-size: 14px;
                        color: #555;
                    }
                    .date-tab strong {
                        font-size: 14px;
                        color: #031B4e;
                    }
                    .time-tabs {
                        padding: 0 20px 0px 10px;
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                    }
                    .time-header {
                        font-size: 14px;
                        font-weight: bold;
                        margin-top: 10px;
                        color: #031B4e;
                    }
                    .time-slot-row {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 10px;
                    }
                    .time-tab {
                        flex: 0 0 calc(20% - 8px);
                        padding: 10px 15px;
                        border: 1px solid #ccc;
                        border-radius: 12px;
                        cursor: pointer;
                        transition: background-color 0.3s ease, transform 0.2s;
                        text-align: center;
                        min-width: 80px;
                        background-color: #fff;
                        font-size: 14px;
                        color: #031B4e;
                    }
                    .time-tab.disabled {
                        opacity: 0.5;
                        pointer-events: none;
                    }
                    .time-tab.selected {
                        border: 2px solid #2ab0e5;
                        color: #031B4e;
                    }
                    @media (max-width: 768px) {
                        .time-tab {
                            flex: 0 0 calc(33.33% - 7px);
                            min-width: 70px;
                            padding: 8px 12px;
                        }
                    }
                    @media (max-width: 500px) {
                        .time-tab {
                            padding: 8px 10px;
                            min-width: 60px;
                        }
                    }
                    .doctor-cards {
                        padding: 0 0px;
                        display: flex;
                        flex-wrap: wrap;
                        gap: 10px;
                    }
                    .doctor-card {
                        width: 170px;
                        height: 205px;
                        border: 1px solid #ccc;
                        border-radius: 10px;
                        background-color: white;
                        overflow: hidden;
                        cursor: pointer;
                        transition: transform 0.3s;
                        text-align: center;
                        padding: 10px;
                        margin: 10px;
                    }
                    .doctor-card img {
                        width: 100%;
                        height: 140px;
                        border-radius: 3px;
                        object-fit: cover;
                    }
                    .doctor-info {
                        padding: 10px;
                    }
                    .doctor-info h3 {
                        margin: 0;
                        font-size: 15px;
                        font-weight: bold;
                    }
                    .doctor-info p {
                        margin: 0;
                        font-size: 11px;
                        color: #777;
                    }
                    .doctor-card.selected {
                        border: 1px solid #2ab0e5;
                    }
                    @media (max-width: 550px) {
                        .doctor-card {
                            width: 140px;
                            padding: 6px;
                            margin: 9px;
                        }
                        .doctor-info h3 {
                            font-size: 12px;
                        }
                        .doctor-info p {
                            font-size: 9px;
                        }
                    }
                    .department-card {
                        display: flex;
                        flex-wrap: wrap;
                    }
                    .department-option {
                        flex: 0 0 calc(25% - 20px);
                        margin: 10px;
                    }
                    @media (max-width: 768px) {
                        .department-option {
                            flex: 0 0 calc(50% - 20px);
                        }
                    }
                    .department-card .icon-content p {
                        font-size: 12px;
                        color: #555;
                        margin: 5px 0 0;
                        display: -webkit-box;
                        -webkit-line-clamp: 2;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                    }
                    .icon-bx .icon-cell i {
                        font-size: 50px;
                        color: #031B4e;
                    }
                </style>
                <div class="col-lg-11" data-bottom-top="transform: translateY(100px)" data-top-bottom="transform: translateY(-10px)">
                    <div class="form-wrapper style-1 text-vr-wrapper">
                        <div class="form-body bg-primary background-blend-burn" style="background-image: url(images/background/bg2.png); background-size: cover; background-color:white !important;">
                            <div class="wizard-container">
                                <form id="wizardform">
                                    <!-- Step 1: Patient Details -->
                                    <div class="step-content active" id="step-content-1">
                                        <div style="width: 100%; display:flex; flex-direction:column; justify-content:center">
                                            <div class="container" style="padding: 20px 0 30px 0; margin-top: 15px; justify-content:center; text-align:center; display: grid;">
                                                <div class="dz-bnr-inr-entry d-table-cell">
                                                    <h1 class="wow fadeInUp" data-wow-delay="0.2s" data-wow-duration="0.8s">Appointment</h1>
                                                    <nav aria-label="breadcrumb" class="breadcrumb-row wow fadeInUp" data-wow-delay="0.4s" data-wow-duration="0.8s">
                                                        <ul class="breadcrumb">
                                                            <li class="breadcrumb-item"><a href="/">Patient Details</a></li>
                                                        </ul>
                                                    </nav>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 formlayout" style="display: flex; flex-wrap: wrap;">
                                            <div class="col-6 m-b30" style="padding:0 60px 0 0">
                                                <div class="form-floating floating-underline input-light">
                                                    <input name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.name %>" type="text" class="form-control" id="inputYourName" placeholder="Your Name" required>
                                                    <label for="inputYourName">Your Name</label>
                                                </div>
                                            </div>
                                            <div class="col-6 m-b30">
                                                <div class="form-floating floating-underline input-light">
                                                    <input type="number" class="form-control" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.age %>" id="inputAge" placeholder="Age" required>
                                                    <label for="inputAge">Age</label>
                                                </div>
                                            </div>
                                            <div class="col-6 m-b30" style="padding: 0 60px 0 0; color:#031B4e">
                                                <label for="gender">Gender</label>
                                                <div class="gender-options" style="padding-top: 10px; display:flex; gap:50px">
                                                    <label class="gender-label">
                                                        <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Male" required> Male
                                                    </label>
                                                    <label class="gender-label">
                                                        <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Female" required> Female
                                                    </label>
                                                    <label class="gender-label">
                                                        <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Other" required> Other
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-6 m-b30">
                                                <div class="form-floating floating-underline input-light">
                                                    <input type="tel" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.phone %>" class="form-control" id="inputContact" placeholder="Contact No." required>
                                                    <label for="inputContact">Contact No.</label>
                                                </div>
                                            </div>
                                            <div class="col-6 m-b30" style="padding:0 60px 0 0">
                                                <div class="form-floating floating-underline input-light">
                                                    <input type="email" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.email %>" class="form-control" id="inputEmail" placeholder="Email ID" required>
                                                    <label for="inputEmail">Email ID</label>
                                                </div>
                                            </div>
                                            <div class="col-6 m-b30">
                                                <div class="form-floating floating-underline input-light">
                                                    <input type="text" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.city %>" class="form-control" id="inputCity" placeholder="City" required>
                                                    <label for="inputCity">City</label>
                                                </div>
                                            </div>
                                            <div class="col-12 m-b30">
                                                <div class="form-floating floating-underline input-light">
                                                    <input type="text" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.address %>" class="form-control" id="inputAddress" placeholder="Address" required>
                                                    <label for="inputAddress">Address</label>
                                                </div>
                                            </div>
                                            <div class="col-12 m-b30">
                                                <div class="form-floating floating-underline input-light">
                                                    <textarea name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.remarks %>" class="form-control" id="inputReason" placeholder="Reason for Appointment" required></textarea>
                                                    <label for="inputReason">Reason for Appointment</label>
                                                </div>
                                            </div>
                                            <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                                                <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow" onclick="nextStep(1)">
                                                    Next <span class="right-icon"><i class="feather icon-arrow-right"></i></span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 2: Department Selection -->
                                    <div class="step-content" id="step-content-2" style="padding-top: 20px;">
                                        <label for="department">Select Department</label>
                                        <div class="col-12 department-card" style="display: flex; flex-wrap: wrap;">
                                            <input type="hidden" id="selectedDepartment" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.department %>" required>
                                            <% specialization.forEach(item => { %>
                                                <div class="col-xl-3 col-md-6 m-b30 wow department-option fadeInUp" data-wow-delay="0.8s" data-wow-duration="0.8s"
                                                    data-department-id="<%= item._id %>" data-name="<%= item.title %>">
                                                    <div style="border:1px solid rgb(0,0,0,0.1)" class="icon-bx-wraper box-hover">
                                                        <div class="icon-bx-head">
                                                            <div class="icon-bx justify-content-center">
                                                                <span class="icon-cell">
                                                                    <% if (item.icon) { %>
                                                                        <img style="width:50px; height:50px;" src="<%= process.env.S3_BASE_URL + item.icon %>" alt="icon">
                                                                    <% } else { %>
                                                                        <img style="width:50px; height:50px;" src="/assets/images/doctorspecialization.png" alt="default icon">
                                                                    <% } %>
                                                                </span>
                                                            </div>
                                                            <div class="icon-content">
                                                                <h3 style="font-size: 16px; margin-top:18px" class="dz-title"><%= item.title %></h3>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                        <script>
                                            let selectedDepartmentId = null;
                                            document.addEventListener("DOMContentLoaded", function () {
                                                const hiddenInput = document.getElementById("selectedDepartment");
                                                const departmentOptions = document.querySelectorAll(".department-option");
                                                departmentOptions.forEach(option => {
                                                    option.addEventListener("click", function () {
                                                        departmentOptions.forEach(opt => opt.classList.remove("selected"));
                                                        this.classList.add("selected");
                                                        selectedDepartmentId = this.getAttribute("data-department-id");
                                                        hiddenInput.value = selectedDepartmentId;
                                                        filterDoctors();
                                                    });
                                                });
                                            });
                                        </script>
                                        <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                                            <button type="button" class="btn btn-lg btn-icon btn-white prev hover-secondary btn-shadow" onclick="prevStep(2)">
                                                <span class="left-icon"><i class="feather icon-arrow-left"></i></span> Previous
                                            </button>
                                            <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow" onclick="nextStep(2)">
                                                Next <span class="right-icon"><i class="feather icon-arrow-right"></i></span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Step 3: Doctor Selection -->
                                    <div class="step-content" id="step-content-3" style="padding-top: 20px;">
                                        <div class="col-sm-12 m-b30 justify-content-center">
                                            <input type="hidden" id="inputDoctor" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.doctor %>" required>
                                            <label for="doctor" style="padding-left: 5px;">Select Doctor</label>
                                            <div class="doctor-cards" style="display: flex; flex-wrap:wrap;">
                                                <% doctors.forEach(item => { %>
                                                    <div class="doctor-card" data-doctor-id="<%= item._id %>" data-name="<%= item.fullName %>"
                                                        data-education="<%= item.education %>" data-image="<%= process.env.S3_BASE_URL + item.profilePicture %>"
                                                        data-specializations='<%= JSON.stringify(item.specializationIds) %>'>
                                                        <img src="<%= process.env.S3_BASE_URL + item.profilePicture %>" alt="Doctor image" class="doctor-image">
                                                        <div class="doctor-info">
                                                            <h3><%= item.fullName %></h3>
                                                            <p><%= item.education %></p>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                        <script>
                                            let selectedDoctorId = null;
                                            function filterDoctors() {
                                                const doctorCards = document.querySelectorAll('.doctor-card');
                                                doctorCards.forEach(card => {
                                                    const specializations = JSON.parse(card.getAttribute('data-specializations'));
                                                    if (selectedDepartmentId && specializations.includes(selectedDepartmentId)) {
                                                        card.style.display = 'block';
                                                    } else {
                                                        card.style.display = 'none';
                                                    }
                                                });
                                            }
                                            document.addEventListener("DOMContentLoaded", function () {
                                                const doctorCards = document.querySelectorAll('.doctor-card');
                                                const hiddenInput = document.getElementById('inputDoctor');
                                                doctorCards.forEach(card => {
                                                    card.addEventListener('click', function () {
                                                        doctorCards.forEach(c => c.classList.remove('selected'));
                                                        this.classList.add('selected');
                                                        selectedDoctorId = this.getAttribute('data-doctor-id');
                                                        hiddenInput.value = selectedDoctorId;
                                                    });
                                                });
                                                filterDoctors();
                                            });
                                        </script>
                                        <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                                            <button type="button" class="btn btn-lg btn-icon btn-white prev hover-secondary btn-shadow" onclick="prevStep(3)">
                                                <span class="left-icon"><i class="feather icon-arrow-left"></i></span> Previous
                                            </button>
                                            <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow" onclick="nextStep(3)">
                                                Next <span class="right-icon"><i class="feather icon-arrow-right"></i></span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Step 4: Preferred Appointment Details -->
                                    <div class="step-content" id="step-content-4" style="padding-top: 20px;">
                                        <div class="col-12" style="display: flex; flex-wrap: wrap;"></div>
                                        <div class="col-12 m-b30">
                                            <label for="preferredDate" style="color: #031b4e; font-size:16px; padding-bottom:10px">Preferred Date</label>
                                            <div class="form-floating floating-underline input-light">
                                                <div class="date-tabs" id="dateTabs"></div>
                                                <input type="hidden" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.date %>" id="selectedDate" required>
                                            </div>
                                        </div>
                                        <label for="preferredTime" style="color: #031b4e; font-size:16px; padding-bottom:10px">Preferred Time</label>
                                        <div class="col-12 m-b30">
                                            <div class="form-floating floating-underline input-light">
                                                <div class="time-tabs" id="timeTabs"></div>
                                                <input type="hidden" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.time %>" id="selectedTime" required>
                                            </div>
                                        </div>
                                        <script>
                                            function showStep(step) {
                                                const steps = document.querySelectorAll('.step-content');
                                                steps.forEach(stepContent => stepContent.classList.remove('active'));
                                                document.getElementById(`step-content-${step}`).classList.add('active');
                                                // Scroll to top
                                                window.scrollTo({
                                                    top: 0,
                                                    behavior: 'smooth' // Smooth scrolling for better user experience
                                                });
                                            }

                                            function formatDate(date) {
                                                const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                                                const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                                                const day = days[date.getDay()];
                                                const dateString = date.getDate().toString().padStart(2, '0');
                                                const month = months[date.getMonth()];
                                                const year = date.getFullYear().toString().slice(-2);
                                                return { fullDate: `${dateString} ${month} ${year}`, day, isoDate: date.toISOString().split('T')[0] };
                                            }
                                            function getDoctorSchedule() {
                                                const doctorData = <%- JSON.stringify(doctors) %>;
                                                const selectedDoctor = doctorData.find(d => d._id === selectedDoctorId);
                                                return selectedDoctor ? selectedDoctor.availabilitySchedule : [];
                                            }
                                            function generateTimeSlotsInRange(startTime, endTime, selectedDate) {
                                                const timeSlots = { Morning: [], Afternoon: [], Evening: [] };
                                                const currentTime = new Date();
                                                const selectedDateObj = new Date(selectedDate);
                                                selectedDateObj.setHours(0, 0, 0, 0);
                                            
                                                // Parse start time (format: "10:00 AM" or "02:30 PM")
                                                const startParts = startTime.split(' ');
                                                const [startHour, startMinute] = startParts[0].split(':').map(Number);
                                                const isStartPM = startParts[1] === 'PM';
                                                let startHour24 = isStartPM ? (startHour % 12) + 12 : startHour % 12;
                                            
                                                // Parse end time
                                                const endParts = endTime.split(' ');
                                                const [endHour, endMinute] = endParts[0].split(':').map(Number);
                                                const isEndPM = endParts[1] === 'PM';
                                                let endHour24 = isEndPM ? (endHour % 12) + 12 : endHour % 12;
                                            
                                                // Generate 30-minute slots
                                                let currentHour = startHour24;
                                                let currentMinute = startMinute;
                                            
                                                while (true) {
                                                    // Break if we've passed the end time
                                                    if (currentHour > endHour24 || 
                                                       (currentHour === endHour24 && currentMinute >= endMinute)) {
                                                        break;
                                                    }
                                            
                                                    // Format the time slot (e.g., "10:00 AM")
                                                    const period = currentHour >= 12 ? 'PM' : 'AM';
                                                    const displayHour = currentHour > 12 ? currentHour - 12 : 
                                                                      (currentHour === 0 ? 12 : currentHour);
                                                    const timeSlot = `${displayHour.toString().padStart(2, '0')}:${currentMinute.toString().padStart(2, '0')} ${period}`;
                                            
                                                    // Check if slot is in the past
                                                    const slotTime = new Date(selectedDateObj);
                                                    slotTime.setHours(currentHour, currentMinute, 0, 0);
                                                    const isPast = slotTime < currentTime;
                                            
                                                    // Determine time of day category
                                                    let timeOfDay;
                                                    if (currentHour < 12) {
                                                        timeOfDay = 'Morning';
                                                    } else if (currentHour < 17) {
                                                        timeOfDay = 'Afternoon';
                                                    } else {
                                                        timeOfDay = 'Evening';
                                                    }
                                            
                                                    // Add to appropriate category
                                                    timeSlots[timeOfDay].push({
                                                        time: timeSlot,
                                                        disabled: isPast
                                                    });
                                            
                                                    // Increment by 30 minutes
                                                    currentMinute += 30;
                                                    if (currentMinute >= 60) {
                                                        currentHour++;
                                                        currentMinute -= 60;
                                                    }
                                                }
                                            
                                                return timeSlots;
                                            }
                                            function populateDateTabs() {
                                                const dateTabsContainer = document.getElementById('dateTabs');
                                                const schedule = getDoctorSchedule();
                                                const currentDate = new Date();
                                                const availableDays = new Set();
                                                schedule.forEach(slot => {
                                                    const days = slot.day.includes('-') ? slot.day.split(' - ').map(d => d.trim()) : [slot.day];
                                                    if (days.length === 2) {
                                                        const startDay = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[0]);
                                                        const endDay = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[1]);
                                                        for (let i = startDay; i <= endDay; i++) {
                                                            availableDays.add(['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'][i]);
                                                        }
                                                    } else {
                                                        availableDays.add(days[0]);
                                                    }
                                                });
                                                dateTabsContainer.innerHTML = '';
                                                for (let i = 0; i < 7; i++) {
                                                    const nextDate = new Date(currentDate);
                                                    nextDate.setDate(currentDate.getDate() + i);
                                                    const { fullDate, day, isoDate } = formatDate(nextDate);
                                                    if (availableDays.has(day)) {
                                                        const tab = document.createElement('div');
                                                        tab.classList.add('date-tab');
                                                        tab.setAttribute('data-value', isoDate);
                                                        tab.innerHTML = `<img src="assets/images/svg/calendar.svg" alt="calendar" /><br><span>${day}</span><br><strong>${fullDate}</strong>`;
                                                        tab.onclick = function () {
                                                            selectDateTab(isoDate, tab);
                                                        };
                                                        dateTabsContainer.appendChild(tab);
                                                    }
                                                }
                                                const defaultDate = Array.from(dateTabsContainer.children)[0]?.getAttribute('data-value');
                                                if (defaultDate) {
                                                    const selectedTab = document.querySelector(`[data-value="${defaultDate}"]`);
                                                    selectDateTab(defaultDate, selectedTab);
                                                }
                                            }
                                            function generateTimeSlots(selectedDate) {
                                                const timeTabsContainer = document.getElementById('timeTabs');
                                                const schedule = getDoctorSchedule();
                                                const selectedDateObj = new Date(selectedDate);
                                                const dayOfWeek = formatDate(selectedDateObj).day;
                                                const timeSlots = { Morning: [], Afternoon: [], Evening: [] };
                                                schedule.forEach(slot => {
                                                    const days = slot.day.includes('-') ? slot.day.split(' - ').map(d => d.trim()) : [slot.day];
                                                    const isDayMatch = days.includes(dayOfWeek) || (days.length === 2 && ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].slice(
                                                        ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[0]),
                                                        ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[1]) + 1
                                                    ).includes(dayOfWeek));
                                                    if (isDayMatch) {
                                                        const slotsInRange = generateTimeSlotsInRange(slot.startTime, slot.endTime, selectedDate);
                                                        for (const period in slotsInRange) {
                                                            timeSlots[period].push(...slotsInRange[period]);
                                                        }
                                                    }
                                                });
                                                let htmlContent = '';
                                                for (const [period, slots] of Object.entries(timeSlots)) {
                                                    if (slots.length > 0) {
                                                        htmlContent += `<div class="time-header">${period}</div><div class="time-slot-row">`;
                                                        slots.forEach(slot => {
                                                            const isDisabled = slot.disabled ? 'disabled' : '';
                                                            htmlContent += `<div class="time-tab ${isDisabled}" data-value="${slot.time}" onclick="selectTime('${slot.time}', this)" ${isDisabled ? 'style="opacity: 0.5; pointer-events: none;"' : ''}>${slot.time}</div>`;
                                                        });
                                                        htmlContent += `</div>`;
                                                    }
                                                }
                                                timeTabsContainer.innerHTML = htmlContent || '<p>No available time slots.</p>';
                                                const firstEnabledSlot = timeTabsContainer.querySelector('.time-tab:not(.disabled)');
                                                if (firstEnabledSlot) {
                                                    selectTime(firstEnabledSlot.getAttribute('data-value'), firstEnabledSlot);
                                                } else {
                                                    const firstSlot = timeTabsContainer.querySelector('.time-tab');
                                                    if (firstSlot) {
                                                        selectTime(firstSlot.getAttribute('data-value'), firstSlot);
                                                    }
                                                }
                                            }
                                            function selectTime(value, selectedTab) {
                                                if (selectedTab.classList.contains('disabled')) return;
                                                document.getElementById('selectedTime').value = value;
                                                document.querySelectorAll('.time-tab').forEach(tab => tab.classList.remove('selected'));
                                                selectedTab.classList.add('selected');
                                            }
                                            function selectDateTab(value, selectedTab) {
                                                document.getElementById('selectedDate').value = value;
                                                document.querySelectorAll('.date-tab').forEach(tab => tab.classList.remove('selected'));
                                                selectedTab.classList.add('selected');
                                                generateTimeSlots(value);
                                            }
                                            document.addEventListener("DOMContentLoaded", function () {
                                                populateDateTabs();
                                            });
                                        </script>
                                        <div class="form-group" style="display: none;">
                                            <input type="hidden" id="websiteProjectId" name="websiteProjectId" value="6760ee6577e9b0d3ffef0e70">
                                        </div>
                                        <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                                            <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary prev btn-shadow" onclick="prevStep(4)">
                                                <span class="left-icon"><i class="feather icon-arrow-left"></i></span> Previous
                                            </button>
                                            <button type="submit" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow">
                                                Submit <span class="right-icon"><i class="feather icon-check-circle"></i></span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <%- include('./partials/enquire.ejs') %>
                            <script>
                                let currentStep = 1;
                                function showStep(step) {
                                    const steps = document.querySelectorAll('.step-content');
                                    steps.forEach(stepContent => stepContent.classList.remove('active'));
                                    document.getElementById(`step-content-${step}`).classList.add('active');
                                }
                                function validateStep(step) {
                                    const currentStepContent = document.getElementById(`step-content-${step}`);
                                    const inputs = currentStepContent.querySelectorAll('input[required], select[required], textarea[required]');
                                    let isValid = true;
                                    inputs.forEach(input => {
                                        if (!input.value) {
                                            isValid = false;
                                            input.classList.add('error');
                                        } else {
                                            input.classList.remove('error');
                                        }
                                    });
                                    return isValid;
                                }
                                function nextStep(step) {
                                    if (validateStep(step)) {
                                        currentStep++;
                                        if (currentStep <= 4) {
                                            showStep(currentStep);
                                            if (currentStep === 3) filterDoctors();
                                            if (currentStep === 4) populateDateTabs();
                                        }
                                    } else {
                                        alert('Please fill all required fields.');
                                    }
                                }
                                function prevStep(step) {
                                    currentStep--;
                                    if (currentStep >= 1) {
                                        showStep(currentStep);
                                        if (currentStep === 3) filterDoctors();
                                    }
                                }
                                showStep(currentStep);
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
<%- include('footer') %>