<section class="content-inner" style="padding-top:100px !important; background:white">
    <div class="container">
        <div class="section-head style-1 m-b30 row align-items-end">
            <div class="col-sm-7 wow fadeInUp" data-wow-delay="0.2s" data-wow-duration="0.8s">
                <h2 class="title m-b0">We Employ only <br> Specialists </h2>
            </div>
            <div class="col-sm-5 text-sm-end d-sm-block d-none wow fadeInUp" data-wow-delay="0.4s" data-wow-duration="0.8s">
                <a href="/team" class="btn btn-icon btn-primary btn-shadow">
                    View All
                    <span class="right-icon"><i class="feather icon-arrow-right"></i></span>
                </a>
            </div>
        </div>
        <div class="row">
<!-- Swiper Container -->
<!-- Swiper Container -->
<div class="swiper-container teamforur" style="overflow: hidden;">
    <div class="swiper-wrapper">
        <% doctors.forEach(item => { %>
            <div class="swiper-slide" style="width: 305px !important">
                <div class="wow fadeInUp" style="margin-bottom: 20px;" data-wow-delay="0.2s" data-wow-duration="0.8s">
                    <div class="dz-team style-1">
                        <div class="dz-media">
                            <div id="doctor-image-<%= item._id %>" 
                                style="width: 100%;height:350px;  overflow: hidden; background: white; display: flex; align-items: center; justify-content: center;">
                             <img 
                               src="<%= process.env.S3_BASE_URL + item.profilePicture %>" 
                               alt="<%= item.fullName %>" 
                               style="width: 100%; height: 100%; object-fit: cover;" 
                               onerror="showInitialsFallback(this, '<%= item._id %>', '<%= item.fullName %>')"
                             >
                           </div>
                           
                           <script>
                             function showInitialsFallback(imgEl, id, name) {
                               const container = document.getElementById(`doctor-image-${id}`);
                               if (!container) return;
                           
                               // Remove failed image
                               imgEl.remove();
                           
                               // Get initials
                               const initials = getInitials(name);
                               if (!initials) return;
                           
                               // Create fallback div
                               const fallbackDiv = document.createElement('div');
                               fallbackDiv.textContent = initials;
                               fallbackDiv.style.cssText = `
                               
                                 display: flex;
                                 align-items: center;
                                 justify-content: center;
                                 font-weight: semibold;
                                 height:100px;
                                 width:100px;
                                 border-radius:50%;
                                 background:#ecf5fb;
                                 font-size: 38px;
                                 color: #2ab0e5;
                               `;
                               container.appendChild(fallbackDiv);
                             }
                           
                             function getInitials(name) {
                               if (!name) return '';
                               const words = name.trim().split(/\s+/);
                               const first = words[0]?.charAt(0).toUpperCase() || '';
                               const second = words[1]?.charAt(0).toUpperCase() || '';
                               return first + (second || '');
                             }
                           </script>
                            <a href="/appointment" class="btn btn-primary">
                                <i class="feather icon-calendar m-r5"></i>
                                Appointment Now
                            </a>
                        </div>
                        <div class="dz-content">
                            <div class="clearfix">
                                <h3 class="dz-name"><a href="/team-details/<%= item._id %>"><%= item.fullName %></a></h3>
                                <span class="dz-position"><%= item.education %></span>
                            </div>
                            <a href="/team-details/<%= item._id %>" class="btn btn-square btn-secondary">
                                <i class="feather icon-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

</div>

<!-- Swiper JS -->
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

<!-- Initialize Swiper -->
<script>
    var swiper = new Swiper('.swiper-container', {
        slidesPerView: 4,  // Number of slides visible at once
        spaceBetween: 20,   // Spacing between slides
        loop: true,         // Loop the slides
        autoplay: {
            delay: 2500,    // Autoplay interval (in milliseconds)
            disableOnInteraction: false, // Keep autoplay even after user interaction
        },
        pagination: {
            el: '.swiper-pagination',
            clickable: true,  // Enable clicking on pagination bullets
        },
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },
        breakpoints: {
            // Responsive breakpoints
            1224: {
                slidesPerView: 4,  // Show 3 slides on tablet screens
            },
            1024:{
                slidesPerView: 3,
            },
            835: {
                slidesPerView: 3,  // Show 2 slides on mobile screens
            },
            500: {
                slidesPerView: 2,  // Show 1 slide on very small screens
            },
            0:{
                slidesPerView: 1,
            }
        },
    });
</script>

<style>
    .teamfour .swiper-slide{
        width: 305px !important;
    }
</style>
          
          
           
        
    </section>