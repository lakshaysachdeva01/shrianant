<% if (popupbanners.length > 0) { %>
    <!-- Popup banner code remains unchanged -->
    <div id="popback" onclick="closepopup()"></div>
    <div id="popup-banner">
        <button id="close-popup">&times;</button>
  
        <!-- Desktop Popup Banner -->
        <div class="desktop-popup-banner">
            <div class="swiper-container desktop-banner" id="desktop-popup-banners">
                <div class="swiper-wrapper">
                    <% popupbanners.forEach(slide => { %>
                        <div class="swiper-slide bgimg">
                            <img src="<%= process.env.S3_BASE_URL + slide.bannerImage.webView %>" alt=""/>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
  
        <!-- Mobile Popup Banner -->
        <div class="mobile-popup-banner">
            <div class="swiper-container mobile-banner" id="mobile-popup-banners">
                <div class="swiper-wrapper">
                    <% popupbanners.forEach(slide => { %>
                        <div class="swiper-slide bgimg">
                            <img src="<%= process.env.S3_BASE_URL + slide.bannerImage.mobileView %>" alt=""/>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- Hero Banner Section with Swiper -->
<div class="hero-banner style-1">
    <!-- Swiper Container for Background Images -->
    <div class="hero-swiper-container">
        <div class="swiper hero-swiper">
            <div class="swiper-wrapper">
                <% banners.forEach(slide => { %>
                    <div class="swiper-slide">
                        <img src="<%= process.env.S3_BASE_URL + slide.bannerImage.webView %>" alt="Hero Banner" class="hero-background-image">
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
    
</div>


<script>
        // Initialize Hero Banner Swiper
        document.addEventListener("DOMContentLoaded", () => {
            // Initialize Hero Banner Swiper
            const heroSwiper = document.querySelector('.hero-swiper');
            if (heroSwiper) {
                new Swiper(heroSwiper, {
                    loop: true,
                    autoplay: {
                        delay: 5000,
                        disableOnInteraction: true, // Changed to true to prevent conflict
                    },
                    effect: 'fade',
                    speed: 1000,
                    allowTouchMove: true,
                    grabCursor: true,
                    // Add touch events configuration
                    touchEventsTarget: 'container',
                    touchRatio: 1,
                    touchAngle: 45,
                    simulateTouch: true,
                    // Add navigation
                    navigation: {
                        nextEl: '.hero-swiper-button-next',
                        prevEl: '.hero-swiper-button-prev',
                    },
                    // Add pagination
                    pagination: {
                        el: '.hero-swiper-pagination',
                        clickable: true,
                        dynamicBullets: true,
                    },
                    // Add keyboard control
                    keyboard: {
                        enabled: true,
                        onlyInViewport: true,
                    },
                    // Add mousewheel control
                    mousewheel: {
                        forceToAxis: true,
                    },
                    // Ensure swiping works properly
                    on: {
                        init: function() {
                            this.el.addEventListener('mouseenter', () => {
                                this.autoplay.stop();
                            });
                            this.el.addEventListener('mouseleave', () => {
                                this.autoplay.start();
                            });
                        },
                        touchStart: function() {
                            this.autoplay.stop();
                        },
                        touchEnd: function() {
                            this.autoplay.start();
                        }
                    }
                });
            }

        // Initialize Additional Banners Swiper
        if (document.getElementById('desktop-additional-banners')) {
            new Swiper('#desktop-additional-banners', {
                loop: true,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                speed: 700,
                effect: 'slide',
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
            });
        }
        
        if (document.getElementById('mobile-additional-banners')) {
            new Swiper('#mobile-additional-banners', {
                loop: true,
                autoplay: {
                    delay: 3000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                speed: 700,
                effect: 'slide',
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
            });
        }

        // Your existing popup banner initialization code
        const bannersExist = document.querySelectorAll('#popup-banner .swiper-slide').length > 0;
        if (!bannersExist) return;

        const popupShown = sessionStorage.getItem('popbackShown');
        if (popupShown) return;

        const popupBanner = document.getElementById('popup-banner');
        const popback = document.getElementById('popback');
        popupBanner.style.display = 'block';
        popback.style.display = 'block';
        document.body.style.overflow = 'hidden';
        sessionStorage.setItem('popbackShown', 'true');

        new Swiper('#desktop-popup-banners', {
            loop: true,
            autoplay: { delay: 5000, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: false,
            speed: 700,
            effect: 'slide',
            on: { slideChangeTransitionEnd: function() { this.autoplay.start(); } }
        });

        new Swiper('#mobile-popup-banners', {
            loop: true,
            autoplay: { delay: 3000, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: false,
            speed: 700,
            effect: 'slide',
            on: { slideChangeTransitionEnd: function() { this.autoplay.start(); } }
        });

        document.getElementById('close-popup').addEventListener('click', closepopup);
        popback.addEventListener('click', closepopup);
    });
    
    function closepopup() {
        const popupBanner = document.getElementById('popup-banner');
        const popback = document.getElementById('popback');
        popupBanner.style.display = 'none';
        popback.style.display = 'none';
        document.body.style.overflow = 'visible';
        sessionStorage.setItem('popbackShown', 'true');
    }
</script>

<style>
    /* Hero Banner Swiper Styles */
    .hero-banner.style-1 {
        position: relative;
        overflow: hidden;
    }
    
    .hero-swiper-container {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;

    }
    
    .hero-swiper {
        width: 100%;
        height: 100%;
    }
    
    .hero-background-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    /* Ensure content stays above the swiper */
    .hero-banner .container {
        position: relative;
        z-index: 1;
    }
    
    /* Hero Swiper Navigation */
    .hero-swiper-button-next,
    .hero-swiper-button-prev {
        color: white;
        background: rgba(0,0,0,0.3);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        cursor: pointer;
    }
    
    .hero-swiper-button-next {
        right: 20px;
    }
    
    .hero-swiper-button-prev {
        left: 20px;
    }
    
    .hero-swiper-button-next:after,
    .hero-swiper-button-prev:after {
        font-size: 20px;
    }
    
    /* Hero Swiper Pagination */
    .hero-swiper-pagination {
        position: absolute;
        bottom: 20px;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: center;
        z-index: 10;
    }
    
    .hero-swiper-pagination .swiper-pagination-bullet {
        width: 12px;
        height: 12px;
        background: white;
        opacity: 0.5;
        margin: 0 5px;
        transition: all 0.3s ease;
    }
    
    .hero-swiper-pagination .swiper-pagination-bullet-active {
        opacity: 1;
        background: #c55200;
        transform: scale(1.2);
    }
    
    /* Additional Banners Styles */
    .additional-banners {
        margin: 20px 0;
    }
    
    .desktop-additional-banner {
        display: block;
    }
    
    .mobile-additional-banner {
        display: none;
    }
    
    .swiper-slide img {
        width: 100%;
        height: auto;
    }
    
    /* Responsive styles */
    @media (max-width: 768px) {
        .desktop-additional-banner {
            display: none;
        }
        
        .mobile-additional-banner {
            display: block;
        }
        
        /* Adjust hero swiper navigation for mobile */
        .hero-swiper-button-next,
        .hero-swiper-button-prev {
            width: 30px;
            height: 30px;
        }
        
        .hero-swiper-button-next:after,
        .hero-swiper-button-prev:after {
            font-size: 16px;
        }
    }
    
    /* Swiper pagination */
    .swiper-pagination-bullet {
        width: 12px;
        height: 12px;
        background: #fff;
        opacity: 0.5;
    }
    
    .swiper-pagination-bullet-active {
        opacity: 1;
        background: #c55200;
    }
</style>