<div class="wizard-container" style="border: 2px solid #2ab0e5; border-radius: 40px">
    <style>
        .wizard-container {
            padding: 10px 53px 40px 53px; 
            background-color: transparent;
            max-width: 800px;
            margin: 12px auto;
        }
        @media (max-width:600px) {
            .wizard-container {
                padding:30px 18px; }
        }
        .progress-bar {
            display: none;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .step {
            text-align: center;
            padding: 5px;
            background-color: lightgray;
            border-radius: 4px;
        }
        .step-content {
            display: none;
        }
        .step-content h2 {
            margin-bottom: 30px;
        }
        .step-content.active {
            display: block;
        }
        .date-tabs {
            display: flex;
            gap: 30px;
            padding: 0 20px 10px 10px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: thin;
            scrollbar-color: #ecf5fb transparent;
        }
        .date-tabs {
            overflow-x: auto;
            scrollbar-width: none;
        }
        .date-tabs::-webkit-scrollbar {
            width: 0;
            height: 0;
        }
        .date-tabs::-webkit-scrollbar-thumb {
            background-color: transparent;
        }
        .date-tabs::-webkit-scrollbar-track {
            background-color: transparent;
        }
        .date-tab {
            display: inline-block;
            min-width: 130px;
            padding: 25px 0;
            border: 1px solid #ccc;
            border-radius: 25px;
            cursor: pointer;
            text-align: center;
            transition: background-color 0.3s ease, transform 0.2s;
        }
        .date-tab.selected {
            border: 1px solid #2ab0e5;
        }
        .date-tab.selected strong,
        .date-tab.selected span {
            color: #031B4e !important;
        }
        .time-tabs {
            padding: 0 20px 0px 10px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .time-header {
            font-size: 14px;
            font-weight: bold;
            margin-top: 10px;
            color: #031B4e;
        }
        .time-slot-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .time-tab {
            display: inline-block;
            padding: 10px 0px;
            border: 1px solid #ccc;
            border-radius: 17px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s;
            text-align: center;
            min-width: 115px;
        }
        .time-tab.selected {
            border: 1px solid #2ab0e5;
            color: #031B4e;
        }
        .time-tab.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
        @media (max-width:768px) {
            .date-tabs, .time-slot-row {
                gap: 10px;
            }
            .time-tab {
                min-width: 103px;
            }
        }
        @media (max-width:500px) {
            .time-tab {
                padding: 10px 39px;
            }
            .date-tabs , .time-tabs {
                padding: 0 4px;}
        }
        @media (max-width:450px) {
            .time-tab {
                padding: 10px 30px;
            }
        }
        @media (max-width:420px) {
            .time-tab {
                padding: 10px 23px;
            }

        }
        @media (max-width:400px) {
            .time-tab {
                padding: 10px 20px;
            }
        }
        @media (max-width:391px) {
            .time-tab {
                padding: 10px 18px;
            }
        }
    </style>
    <form id="wizardform">
        <!-- Step 1: Patient Details -->
        <div class="step-content active" id="step-content-1">
            <div style="width: 100%; display:flex; flex-direction:column; justify-content:center">
                <div class="container" style="padding: 20px 0 30px 0; margin-top: 15px; justify-content:center; text-align:center; display: grid;">
                    <div class="dz-bnr-inr-entry d-table-cell">
                        <h1 class="wow fadeInUp" data-wow-delay="0.2s" data-wow-duration="0.8s">Appointment</h1>
                        <nav aria-label="breadcrumb" class="breadcrumb-row wow fadeInUp" data-wow-delay="0.4s" data-wow-duration="0.8s">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Patient Details</a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <div class="col-12 formlayout" style="display: flex; flex-wrap: wrap;">
                <div class="col-6 m-b30" style="padding:0 60px 0 0">
                    <div class="form-floating floating-underline input-light">
                        <input name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.name %>" type="text" class="form-control" id="inputYourName" placeholder="Your Name" required>
                        <label for="inputYourName">Your Name</label>
                    </div>
                </div>
                <div class="col-6 m-b30">
                    <div class="form-floating floating-underline input-light">
                        <input type="number" class="form-control" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.age %>" id="inputAge" placeholder="Age" required>
                        <label for="inputAge">Age</label>
                    </div>
                </div>
                <div class="col-6 m-b30" style="padding: 0 60px 0 0; color:#031B4e">
                    <label for="gender">Gender</label>
                    <div class="gender-options" style="padding-top: 10px; display:flex; gap:50px">
                        <label class="gender-label">
                            <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Male" required> Male
                        </label>
                        <label class="gender-label">
                            <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Female" required> Female
                        </label>
                        <label class="gender-label">
                            <input type="radio" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.gender %>" value="Other" required> Other
                        </label>
                    </div>
                </div>
                <div class="col-6 m-b30">
                    <div class="form-floating floating-underline input-light">
                        <input type="tel" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.phone %>" class="form-control" id="inputContact" placeholder="Contact No." required>
                        <label for="inputContact">Contact No.</label>
                    </div>
                </div>
                <div class="col-6 m-b30" style="padding:0 60px 0 0">
                    <div class="form-floating floating-underline input-light">
                        <input type="email" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.email %>" class="form-control" id="inputEmail" placeholder="Email ID" required>
                        <label for="inputEmail">Email ID</label>
                    </div>
                </div>
                <div class="col-6 m-b30">
                    <div class="form-floating floating-underline input-light">
                        <input type="text" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.city %>" class="form-control" id="inputCity" placeholder="City" required>
                        <label for="inputCity">City</label>
                    </div>
                </div>
                <div class="col-12 m-b30">
                    <div class="form-floating floating-underline input-light">
                        <input type="text" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.address %>" class="form-control" id="inputAddress" placeholder="Address" required>
                        <label for="inputAddress">Address</label>
                    </div>
                </div>
                <div class="col-12 m-b30">
                    <div class="form-floating floating-underline input-light">
                        <textarea name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.remarks %>" class="form-control" id="inputReason" placeholder="Reason for Appointment" required></textarea>
                        <label for="inputReason">Reason for Appointment</label>
                    </div>
                </div>
                <input type="hidden" id="inputDoctor" value="<%= doctordetails._id %>" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.doctor %>">
                <input type="hidden" id="selectedDepartment" value="<%= doctordetails.specializationIds %>" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.department %>">
                <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                    <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow" onclick="nextStep(1)">
                        Next <span class="right-icon"><i class="feather icon-arrow-right"></i></span>
                    </button>
                </div>
            </div>
        </div>
        <!-- Step 2: Preferred Appointment Details -->
        <div class="step-content" id="step-content-2" style="padding-top: 20px;">
            <div class="col-12" style="display: flex; flex-wrap: wrap;"></div>
            <div class="col-12 m-b30">
                <label for="preferredDate" style="color: #031b4e; font-size:16px; padding-bottom:10px">Preferred Date</label>
                <div class="form-floating floating-underline input-light">
                    <div class="date-tabs" id="dateTabs"></div>
                    <input type="hidden" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.date %>" id="selectedDate" required>
                </div>
            </div>
            <label for="preferredTime" style="color: #031b4e; font-size:16px; padding-bottom:10px">Preferred Time</label>
            <div class="col-12 m-b30">
                <div class="form-floating floating-underline input-light">
                    <div class="time-tabs" id="timeTabs"></div>
                    <input type="hidden" name="<%= WIZARDFORM_ENQUIRY_DYNAMIC_FIELDS_KEYS.time %>" id="selectedTime" required>
                </div>
            </div>
            <script>
                function formatDate(date) {
                    const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    const day = days[date.getDay()];
                    const dateString = date.getDate().toString().padStart(2, '0');
                    const month = months[date.getMonth()];
                    const year = date.getFullYear().toString().slice(-2);
                    return { fullDate: `${dateString} ${month} ${year}`, day, isoDate: date.toISOString().split('T')[0] };
                }

                function getDoctorSchedule() {
                    const doctorData = <%- JSON.stringify(doctordetails) %>;
                    return doctorData.availabilitySchedule || [];
                }

                function generateTimeSlotsInRange(startTime, endTime, selectedDate) {
                    const timeSlots = { Morning: [], Afternoon: [], Evening: [] };
                    const currentTime = new Date();
                    const selectedDateObj = new Date(selectedDate);
                    selectedDateObj.setHours(0, 0, 0, 0);

                    // Parse start time (format: "10:00 AM" or "02:30 PM")
                    const startParts = startTime.split(' ');
                    const [startHour, startMinute] = startParts[0].split(':').map(Number);
                    const isStartPM = startParts[1] === 'PM';
                    let startHour24 = isStartPM ? (startHour % 12) + 12 : startHour % 12;

                    // Parse end time
                    const endParts = endTime.split(' ');
                    const [endHour, endMinute] = endParts[0].split(':').map(Number);
                    const isEndPM = endParts[1] === 'PM';
                    let endHour24 = isEndPM ? (endHour % 12) + 12 : endHour % 12;

                    // Generate 30-minute slots
                    let currentHour = startHour24;
                    let currentMinute = startMinute;

                    while (true) {
                        if (currentHour > endHour24 || (currentHour === endHour24 && currentMinute >= endMinute)) {
                            break;
                        }

                        const period = currentHour >= 12 ? 'PM' : 'AM';
                        const displayHour = currentHour > 12 ? currentHour - 12 : (currentHour === 0 ? 12 : currentHour);
                        const timeSlot = `${displayHour.toString().padStart(2, '0')}:${currentMinute.toString().padStart(2, '0')} ${period}`;

                        const slotTime = new Date(selectedDateObj);
                        slotTime.setHours(currentHour, currentMinute, 0, 0);
                        const isPast = slotTime < currentTime;

                        let timeOfDay;
                        if (currentHour < 12) timeOfDay = 'Morning';
                        else if (currentHour < 17) timeOfDay = 'Afternoon';
                        else timeOfDay = 'Evening';

                        timeSlots[timeOfDay].push({
                            time: timeSlot,
                            disabled: isPast
                        });

                        currentMinute += 30;
                        if (currentMinute >= 60) {
                            currentHour++;
                            currentMinute -= 60;
                        }
                    }

                    return timeSlots;
                }

                function populateDateTabs() {
                    const dateTabsContainer = document.getElementById('dateTabs');
                    const schedule = getDoctorSchedule();
                    const currentDate = new Date();
                    const availableDays = new Set();

                    schedule.forEach(slot => {
                        const days = slot.day.includes('-') ? slot.day.split(' - ').map(d => d.trim()) : [slot.day];
                        if (days.length === 2) {
                            const startDay = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[0]);
                            const endDay = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[1]);
                            for (let i = startDay; i <= endDay; i++) {
                                availableDays.add(['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'][i]);
                            }
                        } else {
                            availableDays.add(days[0]);
                        }
                    });

                    dateTabsContainer.innerHTML = '';
                    for (let i = 0; i < 7; i++) {
                        const nextDate = new Date(currentDate);
                        nextDate.setDate(currentDate.getDate() + i);
                        const { fullDate, day, isoDate } = formatDate(nextDate);
                        if (availableDays.has(day)) {
                            const tab = document.createElement('div');
                            tab.classList.add('date-tab');
                            tab.setAttribute('data-value', isoDate);
                            tab.innerHTML = `<img style="width:20px; padding-bottom:5px" src="/assets/images/svg/calendar.svg" alt="calendar" /><br><span style="font-size:14px">${day}</span><br><strong style="font-size:14px">${fullDate}</strong>`;
                            tab.onclick = function () {
                                selectDateTab(isoDate, tab);
                            };
                            dateTabsContainer.appendChild(tab);
                        }
                    }

                    const defaultDate = Array.from(dateTabsContainer.children)[0]?.getAttribute('data-value');
                    if (defaultDate) {
                        const selectedTab = document.querySelector(`[data-value="${defaultDate}"]`);
                        selectDateTab(defaultDate, selectedTab);
                    }
                }

                function generateTimeSlots(selectedDate) {
                    const timeTabsContainer = document.getElementById('timeTabs');
                    const schedule = getDoctorSchedule();
                    const selectedDateObj = new Date(selectedDate);
                    const dayOfWeek = formatDate(selectedDateObj).day;
                    const timeSlots = { Morning: [], Afternoon: [], Evening: [] };

                    schedule.forEach(slot => {
                        const days = slot.day.includes('-') ? slot.day.split(' - ').map(d => d.trim()) : [slot.day];
                        const isDayMatch = days.includes(dayOfWeek) || (days.length === 2 && ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].slice(
                            ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[0]),
                            ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].indexOf(days[1]) + 1
                        ).includes(dayOfWeek));

                        if (isDayMatch) {
                            const slotsInRange = generateTimeSlotsInRange(slot.startTime, slot.endTime, selectedDate);
                            for (const period in slotsInRange) {
                                timeSlots[period].push(...slotsInRange[period]);
                            }
                        }
                    });

                    let htmlContent = '';
                    for (const [period, slots] of Object.entries(timeSlots)) {
                        if (slots.length > 0) {
                            htmlContent += `<div class="time-header">${period}</div><div class="time-slot-row">`;
                            slots.forEach(slot => {
                                const isDisabled = slot.disabled ? 'disabled' : '';
                                htmlContent += `<div class="time-tab ${isDisabled}" data-value="${slot.time}" onclick="selectTime('${slot.time}', this)" ${isDisabled ? 'style="pointer-events: none; opacity: 0.5;"' : ''}>${slot.time}</div>`;
                            });
                            htmlContent += `</div>`;
                        }
                    }
                    timeTabsContainer.innerHTML = htmlContent || '<p>No available time slots.</p>';

                    const firstEnabledSlot = timeTabsContainer.querySelector('.time-tab:not(.disabled)');
                    if (firstEnabledSlot) {
                        selectTime(firstEnabledSlot.getAttribute('data-value'), firstEnabledSlot);
                    }
                }

                function selectDateTab(value, selectedTab) {
                    document.getElementById('selectedDate').value = value;
                    document.querySelectorAll('.date-tab').forEach(tab => tab.classList.remove('selected'));
                    selectedTab.classList.add('selected');
                    generateTimeSlots(value);
                }

                function selectTime(value, selectedTab) {
                    if (selectedTab.classList.contains('disabled')) return;
                    document.getElementById('selectedTime').value = value;
                    document.querySelectorAll('.time-tab').forEach(tab => tab.classList.remove('selected'));
                    selectedTab.classList.add('selected');
                }

                document.addEventListener("DOMContentLoaded", function () {
                    populateDateTabs();
                });
            </script>
            <div class="form-group" style="display: none;">
                <input type="hidden" id="websiteProjectId" name="websiteProjectId" value="6760ee6577e9b0d3ffef0e70">
            </div>
            <div class="col-sm-12" style="margin-top: 40px; display: flex; justify-content: center;">
                <button type="button" class="btn btn-lg btn-icon btn-white hover-secondary prev btn-shadow" onclick="prevStep(2)">
                    <span class="left-icon"><i class="feather icon-arrow-left"></i></span> Previous
                </button>
                <button type="submit" class="btn btn-lg btn-icon btn-white hover-secondary btn-shadow">
                    Submit <span class="right-icon"><i class="feather icon-check-circle"></i></span>
                </button>
            </div>
        </div>
    </form>
    <%- include('enquire.ejs') %>
    <script>
        let currentStep = 1;

        function showStep(step) {
            const steps = document.querySelectorAll('.step-content');
            steps.forEach(stepContent => stepContent.classList.remove('active'));
            document.getElementById(`step-content-${step}`).classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function validateStep(step) {
            const currentStepContent = document.getElementById(`step-content-${step}`);
            const inputs = currentStepContent.querySelectorAll('input[required], select[required], textarea[required]');
            let isValid = true;
            inputs.forEach(input => {
                if (!input.value) {
                    isValid = false;
                    input.classList.add('error');
                } else {
                    input.classList.remove('error');
                }
            });
            return isValid;
        }

        function nextStep(step) {
            if (validateStep(step)) {
                currentStep++;
                if (currentStep <= 2) {
                    showStep(currentStep);
                }
            } else {
                alert('Please fill all required fields.');
            }
        }

        function prevStep(step) {
            currentStep--;
            if (currentStep >= 1) {
                showStep(currentStep);
            }
        }

        showStep(currentStep);
    </script>
</div>