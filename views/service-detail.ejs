                <div class="content-item wow fadeInUp" data-wow-delay="0.4s" data-wow-duration="0.7s">
                    <h3>Available Doctors Under Surgery</h3>
                    <div class="row">
                        <% specialized.forEach(item => { %>
                        <div class="col-xxl-4 col-sm-6">
                            <div class="dz-team style-1 box-hover">
                                <div class="dz-media">
                                    <div id="doctor-image-<%= item._id %>" 
                                        style="width: 100%;max-height:300px; height: 100%; overflow: hidden; background: white; display: flex; align-items: center; justify-content: center;">
                                     <img 
                                       src="<%= process.env.S3_BASE_URL + item.profilePicture %>" 
                                       alt="<%= item.fullName %>" 
                                       style="width: 100%; height: 100%; object-fit: cover;" 
                                       onerror="showInitialsFallback(this, '<%= item._id %>', '<%= item.fullName %>')"
                                     >
                                   </div>
                                   
                                   <script>
                                     function showInitialsFallback(imgEl, id, name) {
                                       const container = document.getElementById(`doctor-image-${id}`);
                                       if (!container) return;
                                   
                                       // Remove failed image
                                       imgEl.remove();
                                   
                                       // Get initials
                                       const initials = getInitials(name);
                                       if (!initials) return;
                                   
                                       // Create fallback div
                                       const fallbackDiv = document.createElement('div');
                                       fallbackDiv.textContent = initials;
                                       fallbackDiv.style.cssText = `
                                       
                                         display: flex;
                                         align-items: center;
                                         justify-content: center;
                                         font-weight: semibold;
                                         height:100px;
                                         width:100px;
                                         border-radius:50%;
                                         background:#ecf5fb;
                                         font-size: 38px;
                                         color: #2ab0e5;
                                       `;
                                       container.appendChild(fallbackDiv);
                                     }
                                   
                                     function getInitials(name) {
                                       if (!name) return '';
                                       const words = name.trim().split(/\s+/);
                                       const first = words[0]?.charAt(0).toUpperCase() || '';
                                       const second = words[1]?.charAt(0).toUpperCase() || '';
                                       return first + (second || '');
                                     }
                                   </script>
                                   
                                    <a href="/appointment" class="btn btn-primary">
                                        <i class="feather icon-calendar m-r5"></i>
                                        Appointment Now
                                    </a>
                                </div>
                                <div class="dz-content">
                                    <div class="clearfix">
                                        <h3 class="dz-name"><a href="/team-details/<%= item._id %>"><%= item.fullName %></a></h3>
                                        <span class="dz-position"><%= item.specializations.map(tag => tag.title).join(' , ') %> %></span>
                                    </div>
